# Production settings for deploy/docker-compose.yml.
# Copy to deploy/.env (never committed) and fill in every value.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   (or: openssl rand -base64 48)

# Domains. Both DNS records must point to this server.
DOMAIN=bookwise.example.com
API_DOMAIN=api.bookwise.example.com

# Database password (only used inside the Docker network).
POSTGRES_PASSWORD=

# Signs access tokens. At least 32 characters.
JWT_ACCESS_SECRET=

# Email through a transactional provider. Examples:
#   Resend:   smtps://resend:<API_KEY>@smtp.resend.com:465
#   Postmark: smtps://<SERVER_TOKEN>:<SERVER_TOKEN>@smtp.postmarkapp.com:465
# The sender's domain must be verified with the provider.
SMTP_URL=
MAIL_FROM=Bookwise <bookings@example.com>

# Public demo: the owner account of the demo business "Barbería Centro".
# The home page signs visitors in with it ("Try the business dashboard"), so
# treat it as public. The demo is reset every night at 04:00 (Buenos Aires).
# Leave both empty to run without the demo.
DEMO_OWNER_EMAIL=demo@example.com
DEMO_OWNER_PASSWORD=
