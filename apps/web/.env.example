# Where the Bookwise API runs. Only the Next.js server talks to it (never the browser).
API_URL=http://localhost:3001

# Optional: slug of a business to link from the home page (the public demo).
# DEMO_BUSINESS_SLUG=barberia-centro

# Optional: an owner account of the demo business. When both are set, the home
# page shows "Try the business dashboard", which signs visitors in as this user.
# Only the Next.js server reads them. The API creates this user when it has the
# same DEMO_OWNER_* values (see apps/api/.env.example).
# DEMO_OWNER_EMAIL=demo-owner@bookwise.test
# DEMO_OWNER_PASSWORD=change-me-please
