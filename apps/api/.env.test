# Used by the e2e tests (separate database, created by docker/postgres-init.sql).
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://bookwise:bookwise@localhost:5434/bookwise_test?schema=public
# Redis database 1, so tests never touch the development queues (database 0).
REDIS_URL=redis://localhost:6379/1
JWT_ACCESS_SECRET=test-secret-only-used-by-the-e2e-tests-0123456789
# High limit so the e2e suite isn't throttled (the rate limit has its own test).
AUTH_RATE_LIMIT=1000
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Bookwise Tests <no-reply@bookwise.local>
REMINDER_HOURS_BEFORE=24
# Mailpit's HTTP API, used by the tests to read the emails that were sent.
MAILPIT_API_URL=http://localhost:8025
