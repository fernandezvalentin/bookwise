# Copy this file to .env and adjust if needed. The defaults match docker-compose.yml.

NODE_ENV=development
PORT=3001

# Postgres (docker compose service "postgres", host port 5434)
DATABASE_URL=postgresql://bookwise:bookwise@localhost:5434/bookwise?schema=public

# Redis (docker compose service "redis")
REDIS_URL=redis://localhost:6379

# Auth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT=10
