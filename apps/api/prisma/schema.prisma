// Bookwise database schema.
// Models are added stage by stage; run `npm run prisma:migrate` after each change.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Always stored lowercase, so lookups are case-insensitive.
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  memberships   Membership[]
  bookings      Booking[]

  @@map("users")
}

/// Opaque refresh tokens. Only a SHA-256 hash is stored, never the token itself.
/// Each login starts a "family"; every refresh revokes the current token and issues
/// a new one in the same family. Reusing a revoked token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------
//  Businesses (tenants)
// ---------------------------------------------------------------------

enum MemberRole {
  OWNER
  STAFF
}

/// A tenant. Every catalog record belongs to exactly one business.
model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// Public URL identifier: /b/<slug>
  slug      String   @unique
  /// IANA time zone (e.g. "America/Argentina/Buenos_Aires"). Working hours are
  /// expressed in this zone; instants are stored in UTC.
  timezone  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  services    Service[]
  staff       StaffMember[]
  bookings    Booking[]

  @@map("businesses")
}

/// Which users can manage a business, and with which role.
model Membership {
  id         String     @id @default(uuid()) @db.Uuid
  businessId String     @map("business_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  role       MemberRole
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Something customers can book (e.g. "Haircut, 30 min").
model Service {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String
  description String?
  durationMin Int      @map("duration_min")
  /// Minutes blocked after each appointment (cleanup, travel...).
  bufferMin   Int      @default(0) @map("buffer_min")
  /// Price in the smallest currency unit (cents) to avoid floating point errors.
  priceCents  Int      @map("price_cents")
  /// Archived services stay in the database (past bookings reference them).
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    StaffService[]
  bookings Booking[]

  @@index([businessId])
  @@map("services")
}

/// A person customers book with. Optionally linked to a user account.
model StaffMember {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services     StaffService[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  bookings     Booking[]

  @@index([businessId])
  @@map("staff_members")
}

/// Which services each staff member provides.
model StaffService {
  staffId   String @map("staff_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_services")
}

/// A weekly working interval in the business's local time. Several intervals
/// per day are allowed (e.g. 09:00-13:00 and 15:00-19:00).
model WorkingHours {
  id          String @id @default(uuid()) @db.Uuid
  staffId     String @map("staff_id") @db.Uuid
  /// ISO weekday: 1 = Monday ... 7 = Sunday.
  weekday     Int
  /// Minutes since local midnight (540 = 09:00).
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
  @@map("working_hours")
}

/// A period when a staff member is unavailable (vacation, appointment...).
model TimeOff {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
  @@map("time_off")
}

// ---------------------------------------------------------------------
//  Bookings
// ---------------------------------------------------------------------

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// An appointment. Overlapping CONFIRMED bookings for the same staff member are
/// rejected by an exclusion constraint in the database (see the migration).
model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @map("business_id") @db.Uuid
  serviceId      String        @map("service_id") @db.Uuid
  staffId        String        @map("staff_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  startsAt       DateTime      @map("starts_at") @db.Timestamptz(3)
  /// End of the appointment itself.
  endsAt         DateTime      @map("ends_at") @db.Timestamptz(3)
  /// End of the appointment plus the service buffer: the staff member is busy until then.
  blockedUntil   DateTime      @map("blocked_until") @db.Timestamptz(3)
  status         BookingStatus @default(CONFIRMED)
  /// Snapshot of the service when booked, so history doesn't change with the catalog.
  serviceName    String        @map("service_name")
  durationMin    Int           @map("duration_min")
  priceCents     Int           @map("price_cents")
  notes          String?
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  /// When the reminder email was sent (null = not yet). Prevents duplicate reminders.
  reminderSentAt DateTime?     @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer User        @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId, startsAt])
  /// Used by the reminder sweep: confirmed bookings without a reminder yet.
  @@index([status, reminderSentAt, startsAt])
  @@map("bookings")
}
